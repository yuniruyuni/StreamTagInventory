{
  "name": "@twitch-tag-inventory/e2e",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "check:e2e": "playwright test --update-snapshots",
    "check:e2e:ui": "playwright test --ui --update-snapshots",
    "check:e2e:headed": "playwright test --headed --update-snapshots",
    "check:e2e:start": "run-s 'check:e2e:build' 'check:e2e:serve'",
    "check:e2e:build": "run-p 'check:e2e:build:**'",
    "check:e2e:build:html": "mkdir -p static && cp ../client/src/index.html static/index.html && cp ../client/src/robots.txt static/robots.txt",
    "check:e2e:build:favicon": "bun run ../client/bin/generate-favicon.js",
    "check:e2e:build:avatar": "bun run ../client/bin/generate-avatar.js",
    "check:e2e:build:tailwind": "tailwindcss --minify --input ../client/src/index.css --output ./static/index.css",
    "check:e2e:build:bundle": "bun build --outdir=static/ --entry-naming='[dir]/index.[ext]' ../client/src/index.e2e.tsx",
    "check:e2e:serve": "STATIC_DIR=./static bun run ../server/src/index.ts",
    "check:lint": "biome check .",
    "check:type": "tsc --noEmit",
    "fix:lint": "biome check --write ."
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@tailwindcss/cli": "^4.2.2",
    "@types/node": "^25.6.0",
    "npm-run-all2": "^8.0.4",
    "typescript": "^5.9.3"
  }
}
