// yunirun のデプロイ宣言。
//
// ここに書くのは「アプリだけが知っていること」に限る。ホスト側のポートや uid は
// yunirun が導出するので現れない。秘密の値も書かない。
{
  "app": {
    // yuniruyuni.net 側のアプリ名は tags だが、push している image は
    // stream-tag-inventory。名前が違うので明示する。
    "image": "stream-tag-inventory",

    "database": true,

    // DB 名はアプリ名から導かない。アプリ名は tags なので、書かないと
    // tags という別の DB が作られてデータが引き継がれない。
    //
    // ロール名もここから決まる (stream_tag_inventory と
    // stream_tag_inventory_app)。schema 側の GRANT 先と一致している必要がある。
    "databaseName": "stream_tag_inventory",

    // 秘密でない環境変数。OAuth の client_id は仕様上公開される値。
    "env": {
      "TWITCH_CLIENT_ID": "d2kz8x5se7k6b1n0picux0r7kaozi3",
      "APP_BASE_URL": "https://tags.yuniruyuni.net"
    }
  },

  "workloads": {
    "migration": {
      "image": "stream-tag-inventory-migration"
    }
  }
}
