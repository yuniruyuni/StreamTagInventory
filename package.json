{
  "name": "twitch-tag-inventory",
  "productName": "twitch-tag-inventory",
  "license": "MIT",
  "version": "0.0.1",
  "description": "Twitch Tag Inventory is a tool for managing your twitch streaming category and tags.",
  "type": "module",
  "module": "es2022",
  "keywords": [],
  "author": {
    "name": "yuniruyuni",
    "email": "yuniruyuni@gmail.com"
  },
  "scripts": {
    "start": "run-p 'start:**'",
    "start:backend": "bun run --watch bin/local.ts",
    "start:frontend:static": "mkdir -p static && cp src/index.html static/index.html && cp src/robots.txt static/robots.txt",
    "start:frontend:favicon": "bun run bin/generate-favicon.js",
    "start:frontend:avatar": "bun run bin/generate-avatar.js",
    "start:frontend:bundle": "bun build  --watch --sourcemap=inline --outdir=static/ src/index.tsx",
    "start:frontend:tailwind": "tailwindcss --watch --input src/index.css --output static/index.css",
    "start:test": "bun --watch test src",
    "start:type": "tsc --noEmit --watch",
    "start:lint": "bun run lint",
    "build": "run-s build:frontend",
    "build:frontend": "run-p 'build:frontend:**'",
    "build:frontend:html": "mkdir -p static && cp src/index.html static/index.html && cp src/robots.txt static/robots.txt",
    "build:frontend:favicon": "bun run bin/generate-favicon.js",
    "build:frontend:avatar": "bun run bin/generate-avatar.js",
    "build:frontend:bundle": "NODE_ENV=production bun build --minify --outdir=./static/ src/index.tsx",
    "build:frontend:tailwind": "tailwindcss --minify --input src/index.css --output ./static/index.css",
    "test": "bun test",
    "e2e": "playwright test --update-snapshots",
    "e2e:ui": "playwright test --ui --update-snapshots",
    "e2e:headed": "playwright test --headed --update-snapshots",
    "e2e:start": "run-s 'e2e:build' 'start:backend'",
    "e2e:build": "run-p 'build:frontend:html' 'build:frontend:favicon' 'build:frontend:avatar' 'build:frontend:tailwind' 'e2e:build:bundle'",
    "e2e:build:bundle": "bun build --outdir=static/ --entry-naming='[dir]/index.[ext]' src/index.e2e.tsx",
    "type": "tsc --noEmit",
    "lint": "biome lint",
    "format": "biome format --write",
    "check": "biome check --write"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "clsx": "^2.1.1",
    "i18next": "^25.8.20",
    "i18next-browser-languagedetector": "^8.2.1",
    "react": "^19.2.4",
    "react-call": "^1.8.2",
    "react-dom": "^19.2.4",
    "react-i18next": "^16.5.8",
    "swr": "^2.4.1",
    "ulid": "^3.0.2",
    "wouter": "^3.8.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.8",
    "@happy-dom/global-registrator": "^20.8.4",
    "@playwright/test": "^1.58.2",
    "@tailwindcss/cli": "^4.2.2",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/bun": "^1.3.11",
    "@types/node": "^25.5.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/web": "^0.0.344",
    "bun": "^1.3.11",
    "bun-bagel": "^1.2.0",
    "happy-dom": "^20.8.4",
    "npm-run-all2": "^8.0.4",
    "sharp": "^0.34.5",
    "sharp-ico": "^0.1.5",
    "tailwindcss": "^4.2.2",
    "typescript": "^5.9.3"
  },
  "trustedDependencies": [
    "@biomejs/biome",
    "bun"
  ],
  "resolutions": {
    "@babel/runtime": "^7.26.10"
  }
}
