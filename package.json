{
  "name": "twitch-tag-inventory",
  "productName": "twitch-tag-inventory",
  "license": "MIT",
  "version": "0.0.1",
  "description": "Twitch Tag Inventory is a tool for managing your twitch streaming category and tags.",
  "type": "module",
  "module": "es2022",
  "keywords": [],
  "author": {
    "name": "yuniruyuni",
    "email": "yuniruyuni@gmail.com"
  },
  "scripts": {
    "start": "run-p 'start:**'",
    "start:backend": "bun run --watch bin/local.ts",
    "start:frontend:static": "mkdir -p static && cp src/index.html static/index.html",
    "start:frontend:favicon": "bun run bin/generate-favicon.js",
    "start:frontend:bundle": "bun build  --watch --sourcemap=inline --outdir=static/ src/index.tsx",
    "start:frontend:tailwind": "tailwindcss --watch --input src/index.css --output static/index.css",
    "start:test": "bun --watch test src",
    "start:type": "tsc --noEmit --watch",
    "start:lint": "bun run lint",
    "build": "run-s build:frontend",
    "build:frontend": "run-p 'build:frontend:**'",
    "build:frontend:html": "mkdir -p static && cp src/index.html static/index.html",
    "build:frontend:favicon": "bun run bin/generate-favicon.js",
    "build:frontend:bundle": "NODE_ENV=production bun build --minify --outdir=./static/ src/index.tsx",
    "build:frontend:tailwind": "tailwindcss --minify --input src/index.css --output ./static/index.css",
    "test": "bun test src",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:headed": "playwright test --headed",
    "e2e:start": "run-p 'start:backend' 'e2e:frontend:*' 'start:type'",
    "e2e:frontend:static": "mkdir -p static && cp src/index.html static/index.html",
    "e2e:frontend:favicon": "bun run bin/generate-favicon.js",
    "e2e:frontend:bundle": "bun build --watch --sourcemap=inline --outdir=static/ --entry-naming='[dir]/index.[ext]' src/index.e2e.tsx",
    "e2e:frontend:tailwind": "tailwindcss --watch --input src/index.css --output static/index.css",
    "type": "tsc --noEmit",
    "lint": "biome lint",
    "format": "biome format --write",
    "check": "biome check --write"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "clsx": "^2.1.1",
    "i18next": "^25.2.1",
    "i18next-browser-languagedetector": "^8.1.0",
    "react": "^19.1.0",
    "react-call": "^1.7.0",
    "react-dom": "^19.1.0",
    "react-i18next": "^15.5.2",
    "swr": "^2.3.3",
    "ulid": "^3.0.0",
    "wouter": "^3.7.1"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "@happy-dom/global-registrator": "^17.5.6",
    "@playwright/test": "^1.53.1",
    "@tailwindcss/cli": "^4.1.8",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/bun": "^1.2.15",
    "@types/node": "^22.15.29",
    "@types/react": "^19.1.6",
    "@types/react-dom": "^19.1.5",
    "@types/web": "^0.0.236",
    "bun": "^1.2.15",
    "bun-bagel": "^1.2.0",
    "daisyui": "^5.0.43",
    "happy-dom": "^17.5.6",
    "npm-run-all2": "^8.0.4",
    "sharp": "^0.34.2",
    "sharp-ico": "^0.1.5",
    "tailwindcss": "^4.1.8",
    "typescript": "^5.8.3"
  },
  "trustedDependencies": ["@biomejs/biome", "bun"],
  "resolutions": {
    "@babel/runtime": "^7.26.10"
  }
}
