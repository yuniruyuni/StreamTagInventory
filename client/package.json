{
  "name": "@twitch-tag-inventory/client",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "watch:run": "run-p 'watch:run:**'",
    "watch:run:static": "mkdir -p static && cp src/index.html static/index.html && cp src/robots.txt static/robots.txt",
    "watch:run:favicon": "bun run bin/generate-favicon.js",
    "watch:run:avatar": "bun run bin/generate-avatar.js",
    "watch:run:bundle": "bun run bin/build.ts --watch --sourcemap=inline",
    "watch:run:tailwind": "tailwindcss --watch --input src/index.css --output static/index.css",
    "build": "run-p 'build:**'",
    "build:html": "mkdir -p static && cp src/index.html static/index.html && cp src/robots.txt static/robots.txt",
    "build:favicon": "bun run bin/generate-favicon.js",
    "build:avatar": "bun run bin/generate-avatar.js",
    "build:bundle": "NODE_ENV=production bun run bin/build.ts --minify",
    "build:tailwind": "tailwindcss --minify --input src/index.css --output ./static/index.css",
    "check:lint": "biome check .",
    "check:test": "bun test src/",
    "check:type": "tsc --noEmit",
    "fix:lint": "biome check --write .",
    "watch:test": "bun --watch test src/",
    "watch:type": "tsc --noEmit --watch"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@tanstack/react-query": "^5.100.9",
    "@trpc/client": "^11.16.0",
    "@trpc/react-query": "^11.16.0",
    "clsx": "^2.1.1",
    "i18next": "^26.0.8",
    "i18next-browser-languagedetector": "^8.2.1",
    "react": "^19.2.5",
    "react-call": "^2.0.0",
    "react-dom": "^19.2.5",
    "react-i18next": "^17.0.6",
    "swr": "^2.4.1",
    "ulid": "^3.0.2",
    "wouter": "^3.9.0",
    "y-indexeddb": "^9.0.12",
    "yjs": "^13.6.30"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^20.8.9",
    "@tailwindcss/cli": "^4.2.4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@trpc/server": "^11.17.0",
    "@twitch-tag-inventory/server": "workspace:*",
    "@types/bun": "^1.3.13",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "bun-bagel": "^1.2.0",
    "happy-dom": "^20.8.9",
    "npm-run-all2": "^9.0.0",
    "sharp": "^0.35.0",
    "sharp-ico": "^0.1.5",
    "tailwindcss": "^4.2.2",
    "typescript": "^6.0.2"
  }
}
